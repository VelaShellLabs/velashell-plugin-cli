<Project>

  <!--
    VelaShell 插件工程的构建逻辑。本文件由 NuGet 在工程正文**之后**导入。
    四件事:共享程序集不落地、Avalonia 版本一致性、清单校验、一步出 .vpx。
  -->

  <PropertyGroup>
    <!-- 打包器随本包分发,插件工程无需安装全局工具。 -->
    <VelaPluginCli Condition="'$(VelaPluginCli)' == ''">$(MSBuildThisFileDirectory)..\tools\net11.0\VelaShell.Plugin.Cli.dll</VelaPluginCli>
    <VelaVpxOutputDirectory Condition="'$(VelaVpxOutputDirectory)' == ''">$(MSBuildProjectDirectory)\bin\vpx\</VelaVpxOutputDirectory>
  </PropertyGroup>

  <!--
    共享程序集的运行时资产一律不落插件目录。判定口径**与装载器一致**
    (PluginAssemblyLoadContext:VelaShell.PluginSdk + 以 Avalonia 开头的程序集回落到装载方),
    因为放进去也不会被加载,只是白白撑大包体、还容易让人以为版本是自己带的那份说了算。
    注意这条纪律的另一面:名字以 Avalonia 开头、而宿主并不提供的第三方包(例如社区控件库)
    在运行时同样会被强制共享而找不到 —— 这类依赖请选用不以 Avalonia 开头的包,或改由宿主提供。
  -->
  <!--
    ⚠️ 这里**不能**用 `<PackageReference Update="Avalonia" ... />`。
    `Update` 只在求值阶段(工程正文的 ItemGroup)才是筛选器;写在 <Target> 里面时
    MSBuild 直接忽略它,把元数据盖到**整份 @(PackageReference)** 上 —— 连
    Update="ZZZ压根不存在" 都照盖不误(MSBuild 18.10 / 10.0.400 上均已复现)。
    后果是插件工程的每一个 NuGet 依赖都被剥掉 runtime 资产:编译照过(compile 资产还在),
    但 project.assets.json 里 runtime 全成了 "lib/xxx/_._",于是
    CopyLocalLockFileAssemblies 一个依赖也复制不出来,deps.json 也只剩插件自己那一条。

    这个坑还特别难认:`dotnet restore` **看不见** —— 还原时 NuGet 会设
    ExcludeRestorePackageImports=true,本文件根本不被导入,本目标也就不运行。
    只有 VS 的还原(走项目系统求值,包导入是在的)会中招,而且一旦中过一次,
    往后每次 VS 还原都继续写坏 assets 文件,命令行怎么重建都救不回来。

    在 <Target> 里按名字挑 item,只有 Condition + %(Identity) 这一条路。
  -->
  <Target Name="VelaExcludeSharedRuntimeAssets" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <PackageReference Condition="'%(Identity)' == 'Avalonia'
                                   or $([System.String]::Copy('%(Identity)').StartsWith('Avalonia.'))
                                   or '%(Identity)' == 'VelaShell.PluginSdk'">
        <ExcludeAssets>runtime</ExcludeAssets>
      </PackageReference>
    </ItemGroup>
  </Target>

  <!-- 上一条只管 PackageReference;工程若以 ProjectReference 直接引用了 SDK(仓库内插件),
       这里再兜一道,免得 SDK 的 dll 被复制进插件输出目录。 -->
  <Target Name="VelaStripSharedCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'VelaShell.PluginSdk' or $([System.String]::Copy('%(Filename)').StartsWith('Avalonia'))" />
    </ItemGroup>
  </Target>

  <!--
    Avalonia 版本一致性。NuGet 的精确区间已经能挡住绝大多数情况,这里补的是
    "被别的包传递抬高了版本"这一路 —— 那种情况下 NuGet 只会给一条警告。
  -->
  <Target Name="VelaCheckAvaloniaVersion" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(VelaSkipAvaloniaVersionCheck)' != 'true'">
    <ItemGroup>
      <_VelaAvaloniaRef Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Avalonia'" />
    </ItemGroup>
    <Error Condition="'@(_VelaAvaloniaRef)' != '' and '%(_VelaAvaloniaRef.NuGetPackageVersion)' != '$(VelaAvaloniaVersion)'"
           Code="VELA1001"
           Text="This plugin resolves Avalonia %(_VelaAvaloniaRef.NuGetPackageVersion) but the VelaShell host loads $(VelaAvaloniaVersion). The loader forces plugins to share the host's Avalonia assemblies, so a different version fails at runtime (controls will not cast across the load contexts). Pin Avalonia to $(VelaAvaloniaVersion), or set VelaSkipAvaloniaVersionCheck=true if you know what you are doing." />
  </Target>

  <!--
    清单校验。走的是宿主装载时的同一套规则(vela-plugin validate → PluginManifestReader),
    所以"本机构建过、宿主装不上"这种缝不存在。用戳文件做增量:只有清单或产物变了才跑一次。
  -->
  <Target Name="VelaValidateManifest" AfterTargets="Build"
          Condition="'$(VelaValidateManifestOnBuild)' == 'true' and Exists('$(VelaPluginManifest)') and Exists('$(VelaPluginCli)')"
          Inputs="$(VelaPluginManifest);@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)vela-manifest.stamp">
    <Exec Command="dotnet exec &quot;$(VelaPluginCli)&quot; validate &quot;$(TargetDir.TrimEnd('\'))&quot;"
          StandardOutputImportance="low" />
    <Touch Files="$(IntermediateOutputPath)vela-manifest.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    一步出包:dotnet build -t:PackVpx。
    产物落 bin/vpx/<id>-<version>.vpx。要签名就传 -p:VelaSigningKey=<key.pem>
    (密钥用 `vela-plugin keygen` 生成,别提交进仓库)。
  -->
  <Target Name="PackVpx" DependsOnTargets="Build">
    <Error Condition="!Exists('$(VelaPluginCli)')"
           Code="VELA1003"
           Text="The .vpx packer was not found at '$(VelaPluginCli)'. Reference the VelaShell.PluginSdk.Build package, or install the tool with `dotnet tool install -g VelaShell.Plugin.Cli` and set VelaPluginCli." />
    <MakeDir Directories="$(VelaVpxOutputDirectory)" />
    <PropertyGroup>
      <_VelaPackArgs>pack &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(VelaVpxOutputDirectory.TrimEnd('\'))&quot;</_VelaPackArgs>
      <_VelaPackArgs Condition="'$(VelaPackMask)' != 'true'">$(_VelaPackArgs) --no-mask</_VelaPackArgs>
      <_VelaPackArgs Condition="'$(VelaSigningKey)' != ''">$(_VelaPackArgs) --key &quot;$(VelaSigningKey)&quot;</_VelaPackArgs>
    </PropertyGroup>
    <Exec Command="dotnet exec &quot;$(VelaPluginCli)&quot; $(_VelaPackArgs)" />
  </Target>

</Project>
