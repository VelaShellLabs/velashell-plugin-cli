<?xml version="1.0" encoding="utf-8"?>
<!--
  还原源。除了 nuget.org,多挂一个仓库内的 local-packages/ 目录。

  为什么要它:拆库之后上游(契约 SDK / 本仓库的包)是按 NuGet 取的,于是
  "我改了上游、想看看下游还编不编得过"这件事默认要先发一版才能验。
  挂一个本地目录就不用了 —— 在上游仓库跑

      dotnet pack ... -o <这里>/local-packages -p:Vela...Version=1.6.0-local.1

  然后在本仓库把对应的版本旋钮(Directory.Build.props 里那几个 Vela*Version)
  临时指到 1.6.0-local.1 即可。验完把旋钮改回来,别把 -local 版本合进 main。

  local-packages/ 的内容不入库(见 .gitignore),但**目录本身必须在**:
  NuGet 遇到不存在的本地源会直接把还原判失败,而不是跳过。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
